# Copy to a local .env file and replace placeholders. Never commit real secrets.
SAHYOG_DATABASE_URL=postgresql+psycopg://sahyog_app:CHANGE_ME@localhost:5432/sahyog_dev
SAHYOG_MIGRATION_DATABASE_URL=postgresql+psycopg://sahyog_migrator:CHANGE_ME@localhost:5432/sahyog_dev
SAHYOG_TEST_DATABASE_URL=postgresql+psycopg://sahyog_migrator:CHANGE_ME@localhost:5432/sahyog_test
SAHYOG_AUTH_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SAHYOG_AUTH_ISSUER=sahyog-backend
SAHYOG_ACCESS_TOKEN_EXPIRE_MINUTES=30
SAHYOG_VERIFICATION_TIMEOUT_SECONDS=15
SAHYOG_DETECTOR_BASELINE_MEAN_BPM=72
SAHYOG_DETECTOR_BASELINE_STD_BPM=4
SAHYOG_DETECTOR_SESSION_CACHE_SIZE=256
