{
  "schema_version": "sahyog.anomaly_vectors.v1",
  "status": "PROPOSED - expected outputs follow the proposed semantics in docs/thresholds.md and are not an approved medical, backend, or database contract",
  "owner": "Prasiddh (Role 1 - AI/ML and health monitoring)",
  "created": "2026-11-25",
  "source_document": "docs/thresholds.md",
  "scope": "Deterministic detector-level heart-rate vectors for normal, spike, drop, sustained, noisy, gap, out-of-order, invalid, insufficient-baseline, exact and near boundary, kind change, and baseline replacement behavior. No backend IDs, incident state, dashboard fields, or clinical claims.",
  "units": {
    "heart_rate": "bpm",
    "time": "milliseconds relative to the start of the vector",
    "duration": "milliseconds"
  },
  "configuration_rule": "Each vector uses the top-level detector_config merged with that vector's config_overrides. An empty config_overrides object means the top-level defaults are used unchanged. All values are PROPOSED demo parameters.",
  "sample_expansion": {
    "runs": "A vector may provide runs. Expand each run inclusively from from_ms to to_ms by step_ms. Feed expanded samples in ascending t_ms order.",
    "samples": "A vector may provide explicit samples. Feed them strictly in the listed order. This is used when arrival order differs from timestamp order.",
    "rule": "A vector uses either runs or samples, never both."
  },
  "baseline_replacement_rule": "A vector may provide baseline_replacements. Apply each replacement when the next sample to be fed has t_ms greater than or equal to before_t_ms, and before that sample is fed. A replacement closes any active episode without emitting, resets episode counters, and keeps the last accepted timestamp.",
  "detector_config": {
    "z_threshold": 3.0,
    "std_floor_bpm": 2.0,
    "min_abs_delta_bpm": 15.0,
    "persistence_ms": 10000,
    "min_consecutive_abnormal_samples": 5,
    "max_gap_ms": 5000,
    "normal_confirm_samples": 2,
    "valid_bpm_min": 20,
    "valid_bpm_max": 250,
    "evidence_window_ms": 30000,
    "max_evidence_samples": 60
  },
  "classification_rules": {
    "effective_delta_bpm": "max(z_threshold * max(baseline_std_bpm, std_floor_bpm), min_abs_delta_bpm)",
    "spike": "sample.heart_rate_bpm >= baseline_mean_bpm + effective_delta_bpm",
    "drop": "sample.heart_rate_bpm <= baseline_mean_bpm - effective_delta_bpm",
    "normal": "otherwise",
    "boundary_semantics": "Thresholds are inclusive: equal to the upper threshold is a spike; equal to the lower threshold is a drop.",
    "invalid_sample": "A sample outside valid_bpm_min..valid_bpm_max is rejected without changing classification state or the last accepted timestamp. Only diagnostic rejection counters change."
  },
  "episode_rules": {
    "start": "A spike or drop sample with no active episode, or of a different kind than the active episode, starts a new episode.",
    "persistence": "An event is emitted at the first sample where both min_consecutive_abnormal_samples and persistence_ms are satisfied for the current consecutive abnormal run.",
    "one_event_per_episode": "At most one event is emitted per continuous same-kind episode.",
    "normal_samples": "A normal sample resets the consecutive-abnormal count and the run start, so persistence must be re-established. An active episode closes after normal_confirm_samples consecutive normal samples.",
    "gap": "A gap greater than max_gap_ms closes any active episode and resets normal-confirmation counters. The post-gap sample is accepted and may start a new episode.",
    "out_of_order": "A sample whose t_ms is not later than the last accepted sample is rejected without changing classification state or the last accepted timestamp.",
    "kind_change": "A change from spike to drop or drop to spike closes the current episode and starts a new episode.",
    "no_baseline": "With no explicit baseline, samples are accepted but not classified and no events are emitted.",
    "no_recovery_event": "Returning to normal does not emit an event.",
    "baseline_replacement": "A valid baseline replacement closes any active episode without emitting and resets episode counters."
  },
