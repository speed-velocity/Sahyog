# Copy this file to .env and replace all password placeholders with local-only values.
# These settings initialize the PostgreSQL container; they do not define the backend connection contract.
POSTGRES_USER=sahyog_admin
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_DB=sahyog_dev
POSTGRES_PORT=5432
SAHYOG_MIGRATOR_PASSWORD=replace_with_a_unique_migrator_password
SAHYOG_APP_PASSWORD=replace_with_a_unique_application_password
# Test-only SQLAlchemy URL; use the same local migrator password and target sahyog_test.
SAHYOG_TEST_DATABASE_URL=postgresql+psycopg://sahyog_migrator:replace_with_a_unique_migrator_password@localhost:5432/sahyog_test
